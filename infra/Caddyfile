:80 {
	# ────────────────────────────────────────────────────────
	# 统一反向代理网关：将所有外部流量转发至 code-bench 主服务（端口 :8000）
	# ────────────────────────────────────────────────────────
	# 提示：支持通过环境变量 BENCH_BACKEND 动态覆盖代理目标（例如容器部署时设为 code-bench:8000）
	# 缺省时默认回退到本地的 localhost:8000 端口
	reverse_proxy {$BENCH_BACKEND:localhost:8000}
}
